<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'">
  <title>X Archive</title>
  <link rel="stylesheet" href="css/style.css">
  <script defer src="data/posts.js"></script>
  <script defer src="data/posts-ohiain.js"></script>
  <script defer src="js/app.js"></script>
</head>
<body data-account="1chartmaster">
  <a class="skip-link" href="#feed">Skip to posts</a>
  <header class="mobile-bar">
    <a href="#" class="mobile-title">1ChartMaster Archive</a>
    <button id="filters-toggle" type="button" aria-expanded="false" aria-controls="sidebar">Filters</button>
  </header>
  <button id="overlay-backdrop" class="overlay-backdrop" type="button" aria-label="Close filters" hidden></button>
  <div class="layout">
    <aside id="sidebar" class="sidebar" aria-label="Archive filters and day index">
      <div class="sidebar-heading">
        <h1>X <span>Archive</span></h1>
        <button id="filters-close" type="button" aria-label="Close filters">×</button>
      </div>
      <nav class="account-tabs">
        <button class="account-tab active" data-account="1chartmaster">1ChartMaster</button>
        <button class="account-tab" data-account="ohiain">ohiain</button>
      </nav>
      <p id="archive-summary" class="archive-summary"></p>
      <form id="filter-form" role="search">
        <label for="search">Search archive</label>
        <input id="search" type="search" autocomplete="off" placeholder='Text, $TICKER, "phrase"' aria-describedby="search-help">
        <p id="search-help" class="help">All terms must match. Use quotes for an exact phrase or $ for an exact ticker.</p>
        <fieldset class="image-filter">
          <legend>Images</legend>
          <label><input type="radio" name="images" value="all" checked> All</label>
          <label><input type="radio" name="images" value="with"> With</label>
          <label><input type="radio" name="images" value="without"> Without</label>
        </fieldset>
        <div class="date-filters">
          <label for="from">From<input id="from" type="date"></label>
          <label for="to">To<input id="to" type="date"></label>
        </div>
        <div class="results-row"><p id="result-count" role="status" aria-live="polite"></p><button id="clear-filters" type="button">Clear</button></div>
      </form>
      <nav id="day-index" class="day-index" aria-label="Posts by day"></nav>
    </aside>
    <main id="feed" class="feed" tabindex="-1" aria-label="Archived posts"></main>
  </div>
  <button id="back-to-top" class="back-to-top" type="button" hidden>↑ Top</button>
  <dialog id="lightbox" class="lightbox" aria-label="Image viewer">
    <div class="lightbox-toolbar">
      <button id="image-previous" type="button" aria-label="Previous image">←</button>
      <span id="image-counter" aria-live="polite"></span>
      <button id="image-next" type="button" aria-label="Next image">→</button>
      <button id="lightbox-close" type="button" aria-label="Close image viewer">×</button>
    </div>
    <div class="lightbox-content"><img id="lightbox-image" alt=""><p id="lightbox-error" hidden>Image unavailable in this local archive.</p></div>
  </dialog>
  <noscript><p class="noscript">Enable JavaScript to browse this local archive.</p></noscript>
</body>
</html>
