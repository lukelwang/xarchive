(() => {
  "use strict";

  const DATASETS = {
    "1chartmaster": window.ARCHIVE_POSTS || [],
    "ohiain": window.ARCHIVE_POSTS_OHIAIN || []
  };
  let currentAccount = "1chartmaster";
  let posts = DATASETS[currentAccount];
  let postsById = new Map(posts.map(post => [post.id, post]));
  const byId = id => document.getElementById(id);
  const feed = byId("feed");
  const search = byId("search");
  const from = byId("from");
  const to = byId("to");
  const sidebar = byId("sidebar");
  const dayIndex = byId("day-index");
  const lightbox = byId("lightbox");
  let state = { q: "", from: "", to: "", images: "all", sort: "desc", p: "" };
  let filtered = [];
  let daySections = [];
  let debounce;
  let scrollPending = false;
  let gallery = [];
  let imageIndex = 0;
  let galleryLabel = "";
  let lightboxOpener;

  function element(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function dateLabel(key, options) {
    return new Intl.DateTimeFormat("en-US", { ...options, timeZone: "UTC" }).format(new Date(key + "T12:00:00Z"));
  }

  function tokens(query) {
    return Array.from(query.matchAll(/"([^"]*)"|(\S+)/g), match => {
      const value = (match[1] !== undefined ? match[1] : match[2]).toLowerCase();
      return { value, ticker: match[1] === undefined && /^\$[a-z][a-z0-9.-]{0,9}$/i.test(value) };
    }).filter(token => token.value);
  }

  function matchesSearch(post, queryTokens) {
    return queryTokens.every(token => token.ticker
      ? post.tickers.some(ticker => ticker.toLowerCase() === token.value.slice(1))
      : post.searchText.includes(token.value));
  }

  function hasImages(post) {
    return post.images.length > 0 || Boolean(post.quote && post.quote.images.length);
  }

  function matchesImages(post) {
    return state.images === "all" || (state.images === "with" ? hasImages(post) : !hasImages(post));
  }

  function readHash() {
    const params = new URLSearchParams(location.hash.slice(1));
    const validDate = value => /^\d{4}-\d{2}-\d{2}$/.test(value || "") ? value : "";
    state = {
      q: params.get("q") || "",
      from: validDate(params.get("from")),
      to: validDate(params.get("to")),
      images: ["with", "without"].includes(params.get("images")) ? params.get("images") : "all",
      sort: params.get("sort") === "asc" ? "asc" : "desc",
      p: params.get("p") || ""
    };
  }

  function writeHash(push = false) {
    const params = new URLSearchParams();
    if (state.q) params.set("q", state.q);
    if (state.from) params.set("from", state.from);
    if (state.to) params.set("to", state.to);
    if (state.images !== "all") params.set("images", state.images);
    if (state.sort === "asc") params.set("sort", state.sort);
    if (state.p) params.set("p", state.p);
    const hash = params.toString();
    const url = location.pathname + location.search + (hash ? "#" + hash : "");
    history[push ? "pushState" : "replaceState"](null, "", url);
  }

  function syncControls() {
    search.value = state.q;
    from.value = state.from;
    to.value = state.to;
    document.querySelectorAll('input[name="images"]').forEach(input => { input.checked = input.value === state.images; });
    byId("sort-toggle").textContent = state.sort === "asc" ? "Oldest first" : "Newest first";
    byId("sort-toggle").setAttribute("aria-pressed", String(state.sort === "asc"));
  }

  function revealTarget() {
    const target = postsById.get(state.p);
    if (!target) return;
    if (!matchesSearch(target, tokens(state.q))) state.q = "";
    if (!matchesImages(target)) state.images = "all";
    if (state.from && target.dateKey < state.from) state.from = "";
    if (state.to && target.dateKey > state.to) state.to = "";
  }

  function jumpToPost(id) {
    clearTimeout(debounce);
    readControls();
    state.p = id;
    revealTarget();
    syncControls();
    writeHash(true);
    render();
    closeFilters();
    scrollToTarget();
  }

  function scrollToTarget() {
    const target = byId("p-" + state.p);
    if (target) {
      target.classList.add("jump-target");
      target.scrollIntoView({ block: "start", behavior: "instant" });
      target.focus({ preventScroll: true });
    }
  }

  function textWithTickers(text, className) {
    const paragraph = element("p", className);
    const pattern = /\$[A-Za-z][A-Za-z0-9.-]{0,9}/g;
    let position = 0;
    for (const match of text.matchAll(pattern)) {
      paragraph.append(document.createTextNode(text.slice(position, match.index)));
      const button = element("button", "cashtag", match[0]);
      button.type = "button";
      button.title = "Filter by " + match[0];
      button.addEventListener("click", () => {
        clearTimeout(debounce);
        readControls();
        if (!tokens(state.q).some(token => token.ticker && token.value === match[0].toLowerCase())) {
          state.q = (state.q.trim() + " " + match[0]).trim();
        }
        state.p = "";
        syncControls();
        writeHash();
        render();
        window.scrollTo({ top: 0, behavior: "instant" });
      });
      paragraph.append(button);
      position = match.index + match[0].length;
    }
    paragraph.append(document.createTextNode(text.slice(position)));
    return paragraph;
  }

  function originalLink(url, text) {
    const link = element("a", "", text);
    if (/^https:\/\/(?:www\.)?(?:x\.com|twitter\.com)\//i.test(url || "")) {
      link.href = url;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
    }
    return link;
  }

  function localImageSource(image) {
    return /^images\/[A-Za-z0-9_.-]+$/.test(image.src) ? image.src : "";
  }

  function imageGrid(images, label) {
    const grid = element("div", "image-grid count-" + images.length);
    images.forEach((image, index) => {
      const button = element("button", "image-button");
      button.type = "button";
      button.setAttribute("aria-label", "Enlarge " + label + ", image " + (index + 1));
      const img = element("img");
      img.alt = label + ", image " + (index + 1);
      img.width = image.width;
      img.height = image.height;
      img.loading = "lazy";
      img.decoding = "async";
      const unavailable = () => {
        button.replaceChildren(element("span", "image-unavailable", "Image unavailable in this local archive."));
      };
      img.addEventListener("error", unavailable, { once: true });
      const src = localImageSource(image);
      if (src) { img.src = src; button.append(img); }
      else unavailable();
      button.addEventListener("click", () => openLightbox(images, index, label, button));
      grid.append(button);
    });
    return grid;
  }

  function postCard(post) {
    const article = element("article", "post");
    article.id = "p-" + post.id;
    article.tabIndex = -1;
    const header = element("header", "post-header");
    const permalink = element("a", "post-time", post.timestampLabel);
    permalink.href = "#p=" + encodeURIComponent(post.id);
    permalink.title = "Link to this archived post";
    permalink.addEventListener("click", event => { event.preventDefault(); jumpToPost(post.id); });
    header.append(permalink, originalLink(post.url, "View original on X ↗"));
    article.append(header, textWithTickers(post.text, "post-text"));
    if (post.images.length) article.append(imageGrid(post.images, "Post from " + post.timestampLabel));
    if (post.quote) {
      const quote = post.quote;
      const box = element("section", "quote");
      box.setAttribute("aria-label", "Quoted post");
      const quoteHeader = element("div", "quote-header");
      quoteHeader.append(element("span", "", quote.timestampLabel || "Quoted post"));
      if (quote.inArchive && postsById.has(quote.id)) {
        const jump = element("a", "archive-jump", "In archive ↓");
        jump.href = "#p=" + encodeURIComponent(quote.id);
        jump.addEventListener("click", event => { event.preventDefault(); jumpToPost(quote.id); });
        quoteHeader.append(jump);
      } else quoteHeader.append(originalLink(quote.url, "Open on X ↗"));
      const text = textWithTickers(quote.text, "quote-text clamped");
      text.id = "quote-text-" + post.id;
      const more = element("button", "show-more", "Show more");
      more.type = "button";
      more.setAttribute("aria-expanded", "false");
      more.setAttribute("aria-controls", text.id);
      more.addEventListener("click", () => {
        const expanded = more.getAttribute("aria-expanded") !== "true";
        text.classList.toggle("clamped", !expanded);
        more.setAttribute("aria-expanded", String(expanded));
        more.textContent = expanded ? "Show less" : "Show more";
      });
      box.append(quoteHeader, text, more);
      if (quote.images.length) box.append(imageGrid(quote.images, "Quoted post in " + post.timestampLabel));
      article.append(box);
    }
    return article;
  }

  function render() {
    const queryTokens = tokens(state.q);
    filtered = posts.filter(post => matchesSearch(post, queryTokens) && matchesImages(post)
      && (!state.from || post.dateKey >= state.from) && (!state.to || post.dateKey <= state.to));
    if (state.sort === "asc") filtered = filtered.slice().reverse();
    byId("result-count").textContent = filtered.length + " of " + posts.length + " posts";
    const groups = new Map();
    filtered.forEach(post => {
      if (!groups.has(post.dateKey)) groups.set(post.dateKey, []);
      groups.get(post.dateKey).push(post);
    });
    const content = document.createDocumentFragment();
    const index = document.createDocumentFragment();
    let month = "";
    for (const [day, entries] of groups) {
      const section = element("section", "day-section");
      section.id = "day-" + day;
      const heading = element("h2", "day-heading", dateLabel(day, { weekday: "long", month: "short", day: "numeric", year: "numeric" }) + " · " + entries.length + (entries.length === 1 ? " post" : " posts"));
      heading.id = "heading-" + day;
      section.setAttribute("aria-labelledby", heading.id);
      section.append(heading);
      entries.forEach(post => section.append(postCard(post)));
      content.append(section);
      const nextMonth = day.slice(0, 7);
      if (month !== nextMonth) {
        index.append(element("h2", "", dateLabel(day, { month: "long", year: "numeric" })));
        month = nextMonth;
      }
      const link = element("a", "day-link");
      link.href = "#day-" + day;
      link.dataset.day = day;
      link.append(element("span", "", dateLabel(day, { weekday: "short", month: "short", day: "numeric" })), element("span", "day-count", String(entries.length)));
      link.addEventListener("click", event => {
        event.preventDefault();
        closeFilters();
        byId("day-" + day).scrollIntoView({ block: "start", behavior: "instant" });
        updateScroll();
      });
      index.append(link);
    }
    if (!filtered.length) {
      const empty = element("div", "empty-state");
      empty.append(element("h2", "", "No matching posts"), element("p", "", "Try a different search or date range, or clear the filters."));
      const clear = element("button", "", "Clear all filters");
      clear.type = "button";
      clear.addEventListener("click", clearFilters);
      empty.append(clear);
      content.append(empty);
      index.append(element("p", "help", "No days match the current filters."));
    }
    feed.replaceChildren(content);
    dayIndex.replaceChildren(index);
    daySections = Array.from(feed.querySelectorAll(".day-section"));
    measureQuotes();
    updateScroll();
  }

  function measureQuotes() {
    feed.querySelectorAll(".quote-text.clamped").forEach(text => {
      text.nextElementSibling.hidden = text.scrollHeight <= text.clientHeight + 1;
    });
  }

  function readControls() {
    state.q = search.value;
    state.from = from.value;
    state.to = to.value;
    state.images = document.querySelector('input[name="images"]:checked').value;
  }

  function applyFilters() {
    clearTimeout(debounce);
    readControls();
    state.p = "";
    writeHash();
    render();
  }

  function clearFilters() {
    clearTimeout(debounce);
    state = { q: "", from: "", to: "", images: "all", sort: state.sort, p: "" };
    syncControls();
    writeHash();
    render();
  }

  function closeFilters() {
    const wasOpen = sidebar.classList.contains("is-open");
    sidebar.classList.remove("is-open");
    sidebar.removeAttribute("role");
    sidebar.removeAttribute("aria-modal");
    feed.inert = false;
    byId("overlay-backdrop").hidden = true;
    byId("filters-toggle").setAttribute("aria-expanded", "false");
    if (!lightbox.open) document.body.classList.remove("modal-open");
    if (wasOpen) byId("filters-toggle").focus();
  }

  function updateScroll() {
    byId("back-to-top").hidden = window.scrollY < window.innerHeight;
    const offset = window.innerWidth < 960 ? 125 : 65;
    let current = daySections[0];
    for (const section of daySections) {
      if (section.getBoundingClientRect().top <= offset) current = section;
      else break;
    }
    dayIndex.querySelectorAll(".day-link").forEach(link => {
      if (current && "day-" + link.dataset.day === current.id) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    });
  }

  function showImage() {
    const image = gallery[imageIndex];
    const img = byId("lightbox-image");
    const error = byId("lightbox-error");
    img.hidden = false;
    error.hidden = true;
    img.alt = galleryLabel + ", image " + (imageIndex + 1);
    img.width = image.width;
    img.height = image.height;
    img.onerror = () => { img.hidden = true; error.hidden = false; };
    const src = localImageSource(image);
    if (src) img.src = src;
    else { img.removeAttribute("src"); img.hidden = true; error.hidden = false; }
    byId("image-counter").textContent = (imageIndex + 1) + " / " + gallery.length;
    byId("image-previous").disabled = imageIndex === 0;
    byId("image-next").disabled = imageIndex === gallery.length - 1;
  }

  function openLightbox(images, index, label, opener) {
    gallery = images;
    imageIndex = index;
    galleryLabel = label;
    lightboxOpener = opener;
    showImage();
    lightbox.showModal();
    document.body.classList.add("modal-open");
    byId("lightbox-close").focus();
  }

  function moveImage(direction) {
    const next = imageIndex + direction;
    if (next >= 0 && next < gallery.length) { imageIndex = next; showImage(); }
  }

  byId("filter-form").addEventListener("submit", event => { event.preventDefault(); applyFilters(); });
  document.querySelector(".skip-link").addEventListener("click", event => {
    event.preventDefault();
    feed.scrollIntoView({ block: "start", behavior: "instant" });
    feed.focus({ preventScroll: true });
  });
  search.addEventListener("input", () => { clearTimeout(debounce); debounce = setTimeout(applyFilters, 150); });
  from.addEventListener("change", applyFilters);
  to.addEventListener("change", applyFilters);
  document.querySelectorAll('input[name="images"]').forEach(input => input.addEventListener("change", applyFilters));
  byId("clear-filters").addEventListener("click", clearFilters);
  byId("sort-toggle").addEventListener("click", () => {
    state.sort = state.sort === "desc" ? "asc" : "desc";
    applyFilters();
    syncControls();
    byId("sort-status").textContent = state.sort === "asc" ? "Showing oldest first" : "Showing newest first";
    window.scrollTo({ top: 0, behavior: "instant" });
  });
  byId("filters-toggle").addEventListener("click", () => {
    if (sidebar.classList.contains("is-open")) { closeFilters(); return; }
    sidebar.classList.add("is-open");
    sidebar.setAttribute("role", "dialog");
    sidebar.setAttribute("aria-modal", "true");
    feed.inert = true;
    byId("overlay-backdrop").hidden = false;
    byId("filters-toggle").setAttribute("aria-expanded", "true");
    document.body.classList.add("modal-open");
    search.focus();
  });
  byId("filters-close").addEventListener("click", () => { closeFilters(); byId("filters-toggle").focus(); });
  byId("overlay-backdrop").addEventListener("click", closeFilters);
  byId("back-to-top").addEventListener("click", () => window.scrollTo({ top: 0 }));
  byId("lightbox-close").addEventListener("click", () => lightbox.close());
  byId("image-previous").addEventListener("click", () => moveImage(-1));
  byId("image-next").addEventListener("click", () => moveImage(1));
  lightbox.addEventListener("close", () => {
    if (!sidebar.classList.contains("is-open")) document.body.classList.remove("modal-open");
    if (lightboxOpener && lightboxOpener.isConnected) lightboxOpener.focus();
  });
  lightbox.addEventListener("click", event => { if (event.target === lightbox) lightbox.close(); });
  document.addEventListener("keydown", event => {
    if (lightbox.open) {
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") { event.preventDefault(); moveImage(event.key === "ArrowLeft" ? -1 : 1); }
      if (event.key === "Escape") { event.preventDefault(); lightbox.close(); }
      return;
    }
    if (event.key === "Escape" && sidebar.classList.contains("is-open")) {
      closeFilters();
      byId("filters-toggle").focus();
      return;
    }
    if (sidebar.classList.contains("is-open") && event.key === "Tab") {
      const controls = Array.from(sidebar.querySelectorAll("a[href], button, input")).filter(node => !node.disabled && node.getClientRects().length);
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      return;
    }
    if (event.ctrlKey || event.metaKey || event.altKey || /^(INPUT|TEXTAREA|SELECT|BUTTON)$/.test(event.target.tagName) || event.target.isContentEditable || sidebar.classList.contains("is-open")) return;
    if (event.key === "j" || event.key === "k") {
      const cards = Array.from(feed.querySelectorAll(".post"));
      const offset = window.innerWidth < 960 ? 125 : 65;
      let index = cards.findIndex(card => card.getBoundingClientRect().top >= offset - 8);
      if (index < 0) index = cards.length - 1;
      const current = cards[index];
      if (event.key === "j" && current && Math.abs(current.getBoundingClientRect().top - offset) < 20) index += 1;
      if (event.key === "k") index -= 1;
      const target = cards[Math.max(0, Math.min(cards.length - 1, index))];
      if (target) { event.preventDefault(); target.scrollIntoView({ block: "start", behavior: "instant" }); target.focus({ preventScroll: true }); }
    }
  });
  window.addEventListener("scroll", () => {
    if (!scrollPending) {
      scrollPending = true;
      requestAnimationFrame(() => { updateScroll(); scrollPending = false; });
    }
  }, { passive: true });
  window.addEventListener("resize", () => { if (window.innerWidth >= 960) closeFilters(); measureQuotes(); updateScroll(); });
  window.addEventListener("hashchange", () => {
    clearTimeout(debounce);
    readHash();
    revealTarget();
    syncControls();
    writeHash();
    render();
    scrollToTarget();
  });
  window.addEventListener("popstate", () => {
    clearTimeout(debounce);
    readHash();
    revealTarget();
    syncControls();
    render();
    scrollToTarget();
  });

  if (posts.length) {
    const newest = posts[0].dateKey;
    const oldest = posts[posts.length - 1].dateKey;
    byId("archive-summary").textContent = posts.length + " posts · " + dateLabel(oldest, { month: "short", day: "numeric" }) + " – " + dateLabel(newest, { month: "short", day: "numeric", year: "numeric" });
    from.min = to.min = oldest;
    from.max = to.max = newest;
  } else byId("archive-summary").textContent = "No archive data loaded";
  readHash();
  revealTarget();
  syncControls();
  writeHash();
  render();
  scrollToTarget();

  // Account tab switching
  function switchAccount(account) {
    if (!DATASETS.hasOwnProperty(account)) return;
    currentAccount = account;
    posts = DATASETS[account];
    postsById = new Map(posts.map(post => [post.id, post]));
    state = { q: "", from: "", to: "", images: "all", sort: state.sort, p: "" };
    document.querySelectorAll(".account-tab").forEach(btn => {
      btn.classList.toggle("active", btn.dataset.account === account);
    });
    document.body.dataset.account = account;
    if (posts.length) {
      const newest = posts[0].dateKey;
      const oldest = posts[posts.length - 1].dateKey;
      byId("archive-summary").textContent = posts.length + " posts";
      from.min = to.min = oldest;
      from.max = to.max = newest;
    } else byId("archive-summary").textContent = "No archive data loaded";
    syncControls();
    writeHash();
    render();
  }
  document.querySelectorAll(".account-tab").forEach(btn => {
    btn.addEventListener("click", () => switchAccount(btn.dataset.account));
  });
})();
